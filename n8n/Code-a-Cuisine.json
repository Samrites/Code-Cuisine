        "jsCode": "const data = $input.first().json;\nconst payload = data.output ?? data;\nconst recipes = payload.recipes;\nif (!Array.isArray(recipes) || recipes.length !== 3) {\n  throw new Error('The AI did not return exactly three recipes');\n}\nreturn [{ json: { success: true, recipes: recipes.map((recipe, i) => ({\n  ...recipe, source: 'generated', tempId: `generated_${i+1}`\n})) } }];"
