    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst errors = [];\n\nconst validCuisines = ['de', 'it', 'jp', 'in', 'gourmet', 'fusion'];\nconst validDiets = ['vegetarian', 'vegan', 'keto', 'none'];\nconst validTimeCategories = ['quick', 'medium', 'elaborate'];\n\nconst rawIngredients = Array.isArray(item.ingredients)\n  ? item.ingredients\n  : [];\n\nconst normalizedIngredients = rawIngredients.map((ingredient) => {\n  const structured =\n    typeof ingredient === 'object' &&\n    ingredient !== null;\n\n  const name = structured\n    ? String(ingredient.name ?? '').trim()\n    : String(ingredient ?? '').trim();\n\n  const amount = structured\n    ? Number(ingredient.amount)\n    : null;\n\n  const unit = structured\n    ? String(ingredient.unit ?? '').trim()\n    : '';\n\n  return {\n    name,\n    amount,\n    unit,\n    structured\n  };\n});\n\nconst ingredientIsValid = (ingredient) => {\n  const normalizedName = ingredient.name.toLowerCase();\n\n  const validName =\n    ingredient.name.length >= 2 &&\n    /[a-zA-ZäöüÄÖÜß]/.test(ingredient.name) &&\n    !/^\\d+$/.test(ingredient.name) &&\n    !['test', 'asdf', 'qwe'].includes(normalizedName);\n\n  const validQuantity =\n    !ingredient.structured ||\n    (\n      Number.isFinite(ingredient.amount) &&\n      ingredient.amount > 0 &&\n      ingredient.unit.length > 0\n    );\n\n  return validName && validQuantity;\n};\n\nif (normalizedIngredients.length === 0) {\n  errors.push('At least one valid ingredient is required');\n}\n\nif (\n  normalizedIngredients.some(\n    (ingredient) => !ingredientIsValid(ingredient)\n  )\n) {\n  errors.push(\n    'Each ingredient requires a valid name, positive amount, and unit'\n  );\n}\n\nif (\n  !Number.isInteger(item.servings) ||\n  item.servings < 1 ||\n  item.servings > 12\n) {\n  errors.push('servings must be between 1 and 12');\n}\n\n// 0 Helfer ist erlaubt\nif (\n  !Number.isInteger(item.helpers) ||\n  item.helpers < 0 ||\n  item.helpers > 3\n) {\n  errors.push('helpers must be between 0 and 3');\n}\n\nif (!validCuisines.includes(item.cuisine)) {\n  errors.push('cuisine is invalid');\n}\n\nif (!validTimeCategories.includes(item.timeCategory)) {\n  errors.push('timeCategory is invalid');\n}\n\nconst diet = item.diet || 'none';\n\nif (!validDiets.includes(diet)) {\n  errors.push('diet is invalid');\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n\n      ingredients: normalizedIngredients\n        .filter(ingredientIsValid)\n        .map(({ name, amount, unit }) => ({\n          name,\n          amount,\n          unit\n        })),\n\n      diet,\n\n      valid: errors.length === 0,\n\n      errors\n    }\n  }\n];"
      },
