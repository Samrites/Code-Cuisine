    {
      "parameters": {
        "jsCode": "const recipes = $input.all().map(({ json: r }) => {\n  const parse = (v, fallback) => {\n    if (v === null || v === undefined || v === '') return fallback;\n    if (typeof v !== 'string') return v;\n\n    try {\n      return JSON.parse(v);\n    } catch {\n      return fallback;\n    }\n  };\n\n  const cuisineSlug = ({\n    it: 'italian',\n    italian: 'italian',\n    de: 'german',\n    german: 'german',\n    jp: 'japanese',\n    japanese: 'japanese',\n    in: 'indian',\n    indian: 'indian',\n    gourmet: 'gourmet',\n    fusion: 'fusion'\n  })[String(r.cuisine ?? '').trim().toLowerCase()] ?? 'fusion';\n\n  return {\n    tempId: r.recipe_id,\n    id: r.recipe_id,\n    title: r.title,\n    cuisineSlug: cuisineSlug,\n    description: r.description,\n    likes: Number(r.likes ?? 0),\n    ingredients: parse(r.ingredients, []),\n    instructions: parse(r.instructions, []),\n    prepTime: Number(r.prep_time ?? 0),\n    servings: Number(r.servings ?? 0),\n    helpers: Number(r.helpers ?? 0),\n    nutrition: parse(r.nutrition, {}),\n    cookingTime: Number(r.cooking_time ?? 0),\n    dietTag: r.diet_tag,\n    stepDetails: parse(r.step_details, []),\n    cookCount: Number(r.cook_count ?? 0),\n    userIngredients: parse(r.user_ingredients, []),\n    extraIngredients: parse(r.extra_ingredients, []),\n    source: r.source ?? 'generated'\n  };\n});\n\nreturn [\n  {\n    json: {\n      success: true,\n      recipes\n    }\n  }\n];"
      },
